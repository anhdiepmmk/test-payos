# ==============================================================
# Sao chép file này thành .env.local rồi điền giá trị thật:
#   cp .env.example .env.local
# .env.local đã nằm trong .gitignore — KHÔNG BAO GIỜ commit key thật.
# ==============================================================

# Lấy 3 khóa tại https://my.payos.vn → Kênh thanh toán → Thông tin kênh
# (bấm nút copy trên dashboard để không bị thiếu ký tự)
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# Fallback cho returnUrl/cancelUrl khi request không có header Origin
# (bình thường server tự lấy Origin của trình duyệt — chạy port nào cũng tự khớp,
#  vì returnUrl PHẢI cùng origin với trang nhúng iframe PayOS)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# (Tùy chọn) Provider tra cứu địa lý IP cho trang /admin (proxy /api/admin/ip-lookup).
# Mặc định https://ipwho.is (HTTPS, free, KHÔNG cần key). Chỉ đổi nếu muốn provider khác.
IP_LOOKUP_BASE_URL=https://ipwho.is
