# ==============================================================
# Sao chép file này thành .env.local rồi điền giá trị thật:
#   cp .env.example .env.local
# .env.local đã nằm trong .gitignore — KHÔNG BAO GIỜ commit key thật.
# ==============================================================

# Lấy 3 khóa tại https://my.payos.vn → Kênh thanh toán → Thông tin kênh
# (bấm nút copy trên dashboard để không bị thiếu ký tự)
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# URL gốc của app — dùng làm returnUrl/cancelUrl khi tạo payment link
NEXT_PUBLIC_BASE_URL=http://localhost:3000
